# Supabase > Project Settings > API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # the "anon" / publishable key (public by design, used only to upload via signed URLs)
SUPABASE_SERVICE_ROLE_KEY=            # the secret "service_role" key. NEVER prefix with NEXT_PUBLIC_
# Your single admin password (long) and any long random string for signing the login cookie
ADMIN_PASSWORD=
SESSION_SECRET=
